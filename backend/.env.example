# ── AI (all required) ──
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=zai-org-glm-5-2
OPENAI_API_KEY=

# ── Web intelligence (required) ──
TINYFISH_API_KEY=

# ── Wallet / accounts (all required) ──
MAGIC_SECRET_KEY=
MAGIC_PUBLISHABLE_KEY=
PARTICLE_PROJECT_ID=
PARTICLE_CLIENT_KEY=
PARTICLE_APP_ID=
PARTICLE_SERVER_KEY=
ZERODEV_PROJECT_ID=
ZERODEV_RPC_URL=https://rpc.zerodev.app/api/v3/YOUR_PROJECT_ID/chain/42161
GOOGLE_CLIENT_ID=

# ── Chain — Arbitrum One (production default) ──
# Sepolia (421614) is demo-only and cannot complete UA/EIP-7702/SRA.
ARBITRUM_RPC=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ARBITRUM_CHAIN_ID=42161

# ── x402 (required) ──
X402_FACILITATOR_URL=https://facilitator.payai.network
AGENT_WALLET_PRIVATE_KEY=

# ── Database ──
# Production: postgresql://user:pass@host:5432/axis
DATABASE_URL=sqlite+aiosqlite:///./axis.db

# ── App ──
PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
ENVIRONMENT=development
RATE_LIMIT_PER_MINUTE=30
MAX_X402_SPEND_USDC_PER_DAY=0.10
