# AXIS frontend — all variables required (Vite)

VITE_API_URL=http://localhost:8000

# Magic Labs
VITE_MAGIC_PUBLISHABLE_KEY=pk_live_YOUR_KEY

# Particle Network (Universal Accounts EIP-7702)
VITE_PARTICLE_PROJECT_ID=
VITE_PARTICLE_CLIENT_KEY=
VITE_PARTICLE_APP_ID=

# ZeroDev (v3 RPC — same URL for bundler + paymaster)
VITE_ZERODEV_PROJECT_ID=
VITE_ZERODEV_RPC_URL=https://rpc.zerodev.app/api/v3/YOUR_PROJECT_ID/chain/42161

# Google OAuth (same Client ID as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Dedicated Arbitrum RPC (same as backend ARBITRUM_RPC)
VITE_ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
